# macOS
.DS_Store

# Xcode build output
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# screentime/ is a standalone CLI: keep the source, not the artifacts or the data
screentime/stpoll
screentime/StPoll.app/
screentime/data/

# Cloudflare Worker (worker/, when it exists)
# The Worker holds no secrets today, but .dev.vars is where wrangler would put them.
# Kept ignored so one can never be staged by accident if a secret route returns.
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
# ...but the committed template must survive the wildcard above.
!.dev.vars.example

# Generated by `npm run types` (wrangler types) — 15k lines of runtime typings.
# Regenerable, so not worth versioning; worker/README.md documents the command.
worker/worker-configuration.d.ts
App/Secrets.plist   # only needed if a token relay returns; see git log
