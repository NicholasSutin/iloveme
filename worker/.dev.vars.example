# Copy to `.dev.vars` for local `wrangler dev`. NEVER commit `.dev.vars` — it is
# gitignored at the repo root, and it holds the real client secret.
#
# In staging/production these are set with:
#   npx wrangler secret put STRAVA_CLIENT_SECRET
#   npx wrangler secret put STRAVA_CLIENT_SECRET --env production
#
# `wrangler types` reads this file's KEYS to type `Env`, which is why the example
# is committed and the real values are not.

STRAVA_CLIENT_ID=175321
STRAVA_CLIENT_SECRET=replace-me-never-commit
APP_SHARED_TOKEN=replace-me-generate-with-openssl-rand-hex-32
